TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Секрет для подписи сессий и токенов магической ссылки, минимум 32 символа.
# Генерация: openssl rand -base64 32
# Локально и на проде разные, иначе кука с прода будет валидна на локали.
BETTER_AUTH_SECRET=

# Адрес приложения. Локально http://localhost:3000, на проде https://<домен>.
# Отличается от SITE_URL в contacts.ts: там продовый домен, здесь адрес запуска.
BETTER_AUTH_URL=

# Ключ Resend для отправки писем со ссылкой входа. resend.com → API Keys.
# Опционален: без него ссылка печатается в консоль, отправки нет.
RESEND_API_KEY=

# OAuth-приложение VK ID. vk.com → Создать приложение → Авторизация.
# Адрес возврата: <BETTER_AUTH_URL>/api/auth/callback/vk
# Опциональны: без них кнопка входа через VK не появляется.
VK_ID=
VK_SECRET=